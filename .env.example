# Copy to .env and fill in. The pipeline loads this via python-dotenv.

# The Odds API (https://the-odds-api.com) — required for prop odds / EV.
# Free tier works for daily current odds. Historical snapshots (used by
# `backtest.py --odds`) require a paid plan.
ODDS_API_KEY=

# Optional: preferred bookmaker regions for The Odds API (comma-separated).
ODDS_REGIONS=us

# No keys needed for:
#   - pybaseball (Statcast / FanGraphs scraping)
#   - MLB StatsAPI (statsapi.mlb.com is public)
#   - Open-Meteo (free, no key)
